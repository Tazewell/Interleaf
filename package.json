{
  "name": "interleaf",
  "private": true,
  "version": "0.8.9",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && node scripts/dev.mjs",
    "dev:web": "pnpm --filter @interleaf/web dev",
    "dev:server": "cd apps/server && go run ./cmd/interleaf-server",
    "build": "node scripts/prepare-assets.mjs && pnpm build:processor && pnpm build:server && pnpm --filter @interleaf/web build && pnpm --filter @interleaf/desktop build && pnpm --filter @interleaf/connector build",
    "build:server": "node scripts/build-server.mjs",
    "desktop": "pnpm build && pnpm --filter @interleaf/desktop start",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:go && vitest run",
    "test:go": "cd apps/server && go test ./...",
    "api:generate": "openapi-typescript docs/openapi.yaml -o packages/api-client/src/schema.d.ts",
    "format": "prettier --write apps/web/src apps/desktop packages docs scripts",
    "postinstall": "node scripts/prepare-assets.mjs",
    "build:processor": "pnpm --filter @interleaf/processor build",
    "package": "node scripts/package.mjs",
    "package:dir": "node scripts/package.mjs --dir"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yazl": "3.3.1",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.6.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
